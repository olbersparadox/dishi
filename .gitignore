# Dependencies (recreated by `npm install` — never upload these)
node_modules/

# Next.js build output
.next/
out/

# Secrets — never commit your real keys
.env.local
.env*.local

# OS junk files
.DS_Store
Thumbs.db

# Editor/tool files
*.tsbuildinfo
.vercel

# Private Claude Code context (repo is public)
CLAUDE.local.md

# Simulation fixtures built from REAL user rating history (scripts/build-rating-fixture.ts,
# scripts/build-seal-fixture.ts). Kept out of git: this repo is public, and these are a
# real person's meals even though no names/restaurants/dates are included. Rebuild
# locally when needed.
scripts/rating-history.json
scripts/seal-rows.json
scripts/vision-naming-results.json

# R&D menu corpus: local menu photos + their cached scans (see scripts/menu-corpus/README.md)
scripts/menu-corpus/*
!scripts/menu-corpus/README.md

# Palate-export probe transcripts (scripts/probe-export.ts). Each one embeds a
# REAL export doc — rated dish history, the restaurants they were eaten at, and
# 同檯 companion display names — plus the hosts' replies quoting all of it. This
# repo is public; the runs stay local. Findings belong in the plan doc, in prose.
docs/rnd/probe-runs/
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
.design-sync/fonts/

# Dev harnesses (src/app/dev-*): local-only review surfaces that mount REAL
# components against hand-driven inputs — dev-picker, dev-onboard, dev-naming,
# dev-creature. They were kept untracked by hand until one slipped into a commit
# (2026-08-04); committing one makes Vercel build and PUBLICLY SERVE that route
# on the deployed site, which is the actual reason they stay out.
src/app/dev-*/
